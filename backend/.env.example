NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/it_place_inventory

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated if you need more than one, e.g. both with and without "www.":
# CLIENT_ORIGIN=https://itplace.shop,https://www.itplace.shop
CLIENT_ORIGIN=http://localhost:5183

# Used only by seed/seed.js to create the first owner account
SEED_OWNER_NAME=Owner Account
SEED_OWNER_EMAIL=owner@itplace.shop
SEED_OWNER_PASSWORD=ChangeMe123!
